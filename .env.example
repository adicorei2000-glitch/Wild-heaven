# Nusxa oling: cp .env.example .env
# Qiymatlarni Supabase paneli -> Project Settings -> API dan oling.
# Faqat "anon" / "publishable" kalitni qo'ying. service_role kalitini HECH QACHON qo'ymang.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
